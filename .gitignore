crates/wasm/pkg

# Snapshot copies for dx serve, re-created by `make ui-data`
crates/ui/assets/data/

# Worker wasm module, re-created by `make ui-calc`
crates/ui/assets/calc/

# mdBook output (docs/livre/src is the source)
docs/livre/book/

# Production bundle, re-created by `make ui-build`
/_ui

# Échantillon réel de relevé de notes : donnée personnelle, jamais livrable
/exemple_capsule.html

docs/ux/rapport-*

# Playwright : dépendances et artefacts de run (make e2e)
/node_modules
/test-results
/playwright-report
/blob-report
