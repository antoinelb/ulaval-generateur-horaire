# Generated by Cargo
# will have compiled files and executables
/target
.DS_Store

# These are backup files generated by rustfmt
**/*.rs.bk

# Scraper scratch: re-derivable from the course pages, never a deliverable
data/cache/

organigramme_*.pdf
data/programmes_errors.log
data/cours_errors.log
*.profraw

# rustc incremental-compilation crash dumps — not a code artifact
rustc-ice-*.txt

